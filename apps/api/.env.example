# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.
ENV=development
DATABASE_URL=postgresql://pialy_app:change-me@localhost:5432/pialy
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
