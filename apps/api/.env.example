# Copy to .env (git-ignored) and fill every empty secret. Empty values count as unset,
# so the app refuses to start until you generate real ones. Never commit real values.
# Required, no default: development or production (test is only accepted under pytest).
ENV=development
# LOG_LEVEL is optional: DEBUG, INFO (default), WARNING, ERROR or CRITICAL, in any case.
DATABASE_URL=postgresql://pialy_app:change-me@localhost:5432/pialy
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PHONE_HASH_SALT=
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUDIT_HMAC_KEY=
# generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIALS_ENC_KEY=
