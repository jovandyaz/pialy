{
  "name": "@pialy/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node build.mjs",
    "start": "node dist/migrate.js && node dist/seed.js && node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@pialy/connector-pey": "workspace:*",
    "@pialy/payments": "workspace:*",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
