{
  "name": "pialy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.17.0",
  "engines": { "node": ">=24", "pnpm": ">=12.17.0" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "api:sync": "uv sync --locked --directory apps/api",
    "api:lint": "uv run --directory apps/api ruff check . && uv run --directory apps/api ruff format --check . && uv run --directory apps/api mypy --strict src tests migrations && uv run --directory apps/api lint-imports",
    "api:test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:54329/pialy_test} uv run --directory apps/api pytest",
    "api:dev": "uv run --directory apps/api uvicorn pialy.main:app_factory --factory --reload --port 3000",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm api:lint && pnpm api:test"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
